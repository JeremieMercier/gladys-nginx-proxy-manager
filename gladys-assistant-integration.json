{
  "manifest_version": 1,
  "type": "device",
  "name": "Nginx Proxy Manager",
  "description": {
    "en": "Connect your Nginx Proxy Manager instance to Gladys, test it and open its admin portal.",
    "fr": "Connectez votre instance Nginx Proxy Manager à Gladys, testez-la et ouvrez son portail."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/jeremiemercier/gladys-nginx-proxy-manager:1.0.0",
  "gladys_version": ">=4.86.0",
  "cover_image": "https://raw.githubusercontent.com/JeremieMercier/gladys-nginx-proxy-manager/main/cover.png",
  "categories": ["network", "services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Connect to Nginx Proxy Manager", "fr": "Connexion à Nginx Proxy Manager" },
      "description": {
        "en": "Enter the URL of your Nginx Proxy Manager admin interface (the one you open in your browser, port 81 by default) and the credentials of an administrator account. Gladys must be able to reach this URL from its own network.",
        "fr": "Renseignez l'URL de l'interface d'administration de Nginx Proxy Manager (celle que vous ouvrez dans votre navigateur, port 81 par défaut) et les identifiants d'un compte administrateur. Gladys doit pouvoir joindre cette URL depuis son propre réseau."
      },
      "links": [
        {
          "url": "https://nginxproxymanager.com/guide/",
          "label": {
            "en": "Nginx Proxy Manager documentation",
            "fr": "Documentation Nginx Proxy Manager"
          }
        }
      ]
    },
    {
      "key": "npm_url",
      "type": "string",
      "label": { "en": "Admin interface URL", "fr": "URL de l'interface d'administration" },
      "description": {
        "en": "Example: http://192.168.1.10:81",
        "fr": "Exemple : http://192.168.1.10:81"
      },
      "placeholder": { "en": "http://192.168.1.10:81", "fr": "http://192.168.1.10:81" },
      "required": true
    },
    {
      "key": "email",
      "type": "string",
      "label": { "en": "Administrator email", "fr": "E-mail administrateur" },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": { "en": "Administrator password", "fr": "Mot de passe administrateur" },
      "required": true
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": { "en": "Test the connection", "fr": "Tester la connexion" },
      "timeout_seconds": 30
    },
    {
      "key": "open_portal",
      "label": { "en": "NPM portal", "fr": "Portail NPM" },
      "timeout_seconds": 10
    }
  ]
}
